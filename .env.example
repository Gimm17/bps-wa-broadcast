# Runtime environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bps_whatsapp

# Application Secrets (minimum 32 characters or 64 hex chars for AES-256-GCM)
SESSION_SECRET=dev_session_secret_bps_sulteng_2026_at_least_32_chars!
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PUBLIC_APP_URL=http://localhost:5173

# Meta WhatsApp Cloud API (optional for initial setup)
META_APP_ID=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
