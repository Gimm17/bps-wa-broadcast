# ==============================================================================
# BPS Provinsi Sulawesi Tengah WhatsApp Broadcast Platform - Environment Contract
# ==============================================================================

# 1. Runtime Environment
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_APP_URL=https://whatsapp.sulteng.bps.go.id

# 2. PostgreSQL Connection (PostgreSQL 16+ required, include search_path for schema isolation)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?search_path=bps_whatsapp,public
DATABASE_URL=postgresql://user_bps:ChangeMePasswordDb2026!@127.0.0.1:5432/bps_broadcast_prod?search_path=bps_whatsapp,public

# 3. Cryptography & Security Secrets
# SESSION_SECRET: Minimum 32 characters for HMAC cookie signing
SESSION_SECRET=change_me_to_at_least_32_characters_random_string_2026!
# APP_ENCRYPTION_KEY: Exactly 32 bytes (64 hex characters) for AES-256-GCM token encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. Meta WhatsApp Business Cloud API (Graph API v21.0)
META_APP_ID=
META_APP_SECRET=your_meta_app_secret_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WABA_ID=your_waba_account_id_here
META_ACCESS_TOKEN=your_permanent_system_user_token_here
META_WEBHOOK_VERIFY_TOKEN=bps_sulteng_waba_verify_2026

# 5. Backup & Operational Configuration
# Directory for database compressed backups (.dump)
BACKUP_DIR=./backups
# Retention in days before automated pruning
BACKUP_RETENTION_DAYS=30
# Optional custom path to pg_dump binary if not in system PATH
# PG_DUMP_PATH=/usr/bin/pg_dump
